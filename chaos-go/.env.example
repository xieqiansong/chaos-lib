# chaos-go 配置文件模板
# 复制此文件为 .env 并填入实际值，然后通过 APP_ENV=dev 或 -env=dev 使用
#
# 环境切换方式：
#   1. -env=dev|prod 命令行参数（推荐）
#   2. APP_ENV=prod 环境变量
#   3. 默认 .env（优先级最高），其次 .env.dev，最后 .env.prod

# 服务器配置
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# 数据库配置
# 数据库类型：postgres / sqlite（切换只需改 DB_TYPE）
DB_TYPE=sqlite
# sqlite 模式下的数据库文件路径（相对程序运行目录，目录会自动创建）
DB_PATH=data/chaos.db
# 以下为 postgres 模式配置（DB_TYPE=postgres 时生效）
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=chaos
DB_SSLMODE=disable

# Pprof 性能分析
PPROF_ENABLED=false
PPROF_PORT=6060
PPROF_HOST=localhost

# 功能开关
FEATURE_FILE_LINK=true

# 日志配置
LOG_LEVEL=info

# DeepSeek API 配置（可选，用于余额查询功能）
DEEPSEEK_API_KEY=

# 百度地图 API 配置（可选，用于手机小看板天气）
BAIDU_AK=

# Supabase 云端数据通道（Data API / PostgREST）
# 凭据只通过 apikey 请求头传递；新式 key 不是 JWT，放进 Authorization 会被判 Invalid JWT
SUPABASE_URL=https://your-project-ref.supabase.co
# 后端专用：绕过 RLS，只放本文件（.env 已被 .gitignore 忽略），禁止提交
SUPABASE_SECRET_KEY=
# 受 RLS 约束，保留给将来的前端只读场景，后端不使用
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SCHEMA=public
SUPABASE_TIMEOUT_SEC=15
# 允许访问的表名清单（逗号分隔）；留空表示该通道不可用
SUPABASE_TABLES=
